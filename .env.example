# Applywise Environment Configuration
# Duplicate this file as .env.local and populate the keys below to enable cloud syncing.

# Supabase database configuration credentials
# Find these inside your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only keys for secure extension token storage.
# Never expose these in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EXTENSION_TOKEN_SECRET=generate-a-long-random-secret
